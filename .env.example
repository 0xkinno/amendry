# ═══════════════════════════════════════════════════════════════════
# AMENDRY — Environment Variables
# ═══════════════════════════════════════════════════════════════════
#
# These secrets belong in your Convex deployment, NOT in .env files
# committed to Git. This file is for documentation only.
#
# Setup:
#   npx convex env set OPENAI_API_KEY "sk-..."
#   npx convex env set FIRECRAWL_API_KEY "fc-..."
#   npx convex env set AGENTMAIL_API_KEY "..."
#   npx convex env set AGENTMAIL_WEBHOOK_SECRET "..."
#   npx convex env set AMENDRY_SOURCE_MODE "FIXTURE"
#   npx convex env set AGENTMAIL_POLL "1"
# ═══════════════════════════════════════════════════════════════════

# Required: OpenAI API key for structured extraction, impact analysis,
# clarification drafting, and reply parsing.
OPENAI_API_KEY=sk-your-key-here

# Required: Firecrawl API key for live tender source fetching.
# Starts with "fc-". Without it, the app runs in FIXTURE mode.
FIRECRAWL_API_KEY=fc-your-key-here

# Optional: AgentMail API key for outbound clarification emails.
# Without it, outbound mail is simulated in FIXTURE mode.
AGENTMAIL_API_KEY=

# Optional: AgentMail webhook secret for inbound reply verification.
# Without it, the webhook still works but skips signature verification.
AGENTMAIL_WEBHOOK_SECRET=

# Optional: Force source mode. "LIVE" or "FIXTURE".
# Auto-detected from Firecrawl key when unset.
AMENDRY_SOURCE_MODE=

# Optional: "1" to poll the inbox from a cron (no public URL needed).
AGENTMAIL_POLL=
