{
  "name": "amendry",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Amendry — live tender integrity desk. Keeps every tender response synchronized with the source that can invalidate it.",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "convex dev --tail-logs always",
    "dev:frontend": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false && tsc -p convex --noEmit --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "attack": "tsx scripts/attack-campaign.mjs",
    "benchmark": "node scripts/run-benchmark.mjs",
    "verify:proof": "node scripts/verify-proof.mjs",
    "check:wording": "node scripts/check-wording.mjs",
    "evidence": "node scripts/collect-evidence.mjs",
    "env:push": "node scripts/push-env.mjs",
    "deploy": "convex deploy --yes && static-hosting deploy --skip-convex"
  },
  "dependencies": {
    "@agentmail/convex": "0.1.0",
    "@convex-dev/auth": "^0.0.95",
    "@convex-dev/rate-limiter": "0.4.0",
    "@convex-dev/static-hosting": "0.2.1",
    "@convex-dev/workflow": "0.4.8",
    "@convex-dev/workpool": "0.4.12",
    "@firecrawl/firecrawl-convex": "0.1.1",
    "clsx": "^2.1.1",
    "convex": "^1.46.0",
    "convex-helpers": "^0.1.124",
    "framer-motion": "^12.23.0",
    "openai": "^7.20.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.9.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
